# Docker Environment Configuration
# Copy this file to .env when running with Docker

APP_NAME="Meracikopi"
APP_KEY=
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8001

# Database Configuration (matches docker-compose.yml)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=meracikopi
DB_USERNAME=meracikopi
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# MySQL Image Variables
MYSQL_DATABASE=meracikopi
MYSQL_USER=meracikopi
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=rootsecret

# Cache & Session (using Redis in Docker)
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Midtrans Configuration
# Replace with your actual keys
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# DOKU Payment Gateway (sandbox)
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_API_KEY=
DOKU_PUBLIC_KEY=
DOKU_IS_PRODUCTION=false
DOKU_FALLBACK_ENABLED=false

# DOKU SNAP Configuration
DOKU_SNAP_TOKEN_URL=http://127.0.0.1:8001/api/doku/token
DOKU_SNAP_RETURN_URL=http://127.0.0.1:8001/checkout/success
DOKU_SNAP_CANCEL_URL=http://127.0.0.1:8001/checkout/cancel
DOKU_SNAP_ERROR_URL=http://127.0.0.1:8001/checkout/error

# Merchant Keys (untuk signature dari aplikasi kita ke DOKU)
MERCHANT_PRIVATE_KEY=
MERCHANT_PUBLIC_KEY=

# Service Fee
SERVICE_FEE=0

# Mail Configuration (use mailhog for testing)
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@meracikopi.com"
MAIL_FROM_NAME="${APP_NAME}"

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=info
